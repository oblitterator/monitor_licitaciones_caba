# =====================================================================
# Variables de producción. Copiá este archivo a deploy/.env y completalo:
#   cp deploy/env.example deploy/.env && chmod 600 deploy/.env
# deploy/.env NUNCA se commitea (está en .gitignore). Acá van solo ejemplos.
#
# Las contraseñas van dentro de URLs de conexión: usá solo letras y números.
# Para generarlas:  openssl rand -hex 24
# =====================================================================

# --- Postgres -------------------------------------------------------
# Nombre de la base y superusuario (lo usan la ingesta y el backup)
POSTGRES_DB=boletin_oficial_caba
POSTGRES_USER=postgres
# Contraseña del superusuario
POSTGRES_PASSWORD=cambiame_superusuario
# Contraseña del usuario de solo lectura monitor_web (lo usa el sitio)
MONITOR_WEB_PASSWORD=cambiame_monitor_web

# Zona horaria de todos los contenedores (horarios de la ingesta y el backup)
TZ=America/Argentina/Buenos_Aires

# --- Sitio web ------------------------------------------------------
# URL pública, sin barra final (canonical, sitemap, Open Graph)
SITE_URL=https://licitaciones.example.org
# Cloudflare Turnstile en los formularios: true en producción, false para probar
TURNSTILE_ENABLED=false
# Clave pública del widget (Cloudflare > Turnstile)
TURNSTILE_SITE_KEY=
# Clave secreta de Turnstile
TURNSTILE_SECRET_KEY=

# --- Ingesta diaria -------------------------------------------------
# Hora de la corrida diaria (HH:MM, hora local según TZ)
INGESTA_HORA=07:30
# Máximo de PDFs por corrida (la concurrencia queda en 6, la de siempre)
INGESTA_LIMITE_PDFS=2000
# 1 = también baja el snapshot de Buenos Aires Compras (solo si cambió); 0 = no
INGESTA_BAC=1
# 1 = también baja y parsea designaciones de funcionarios (cruce con IGJ). El sitio no lo muestra
INGESTA_FUNCIONARIOS=0
# Aviso opcional a un monitor tipo healthchecks.io (se le pega a la URL si sale
# bien y a URL/fail si falla). Vacío = sin aviso.
AVISO_URL_INGESTA=

# --- Respaldo con LLM (opcional, apagado) ---------------------------
# 1 = manda los actos dudosos a Claude Haiku en cada corrida (requiere la clave)
LLM_HABILITADO=0
# Máximo de actos por corrida
LLM_LIMITE=500
# Clave de la API de Anthropic. Vacía = el paso del LLM no corre
ANTHROPIC_API_KEY=

# --- Backups a Cloudflare R2 ----------------------------------------
# Endpoint S3 de R2: https://<ID_DE_CUENTA>.r2.cloudflarestorage.com
R2_ENDPOINT=https://ID_DE_CUENTA.r2.cloudflarestorage.com
# Nombre del bucket
R2_BUCKET=monitor-licitaciones-backups
# Carpeta dentro del bucket
R2_PREFIJO=backups
# Token de API de R2 con permiso "Object Read & Write" sobre ese bucket
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Hora del backup nocturno (HH:MM, hora local)
BACKUP_HORA=03:30
# Cuántos backups diarios y semanales se guardan
BACKUP_DIARIOS=14
BACKUP_SEMANALES=8
# Día del backup semanal: 1 = lunes ... 7 = domingo
BACKUP_DIA_SEMANAL=7
# Aviso opcional, igual que AVISO_URL_INGESTA
AVISO_URL_BACKUP=

# --- Cloudflare Tunnel ----------------------------------------------
# Token del túnel (Zero Trust > Networks > Tunnels > tu túnel > token)
CLOUDFLARE_TUNNEL_TOKEN=
