# Copiar a .env.local y completar. Nunca commitear el archivo real.
# Conexión a Postgres para `next dev` / `next start` (en Cloudflare se usa Hyperdrive).
DATABASE_URL=postgres://usuario:contraseña@127.0.0.1:5432/boletin_oficial_caba
# URL pública del sitio (canonical, sitemap, Open Graph)
SITE_URL=http://localhost:3000
# Cloudflare Turnstile en los formularios. En "false" no se verifica (desarrollo local).
TURNSTILE_ENABLED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
